{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TitoV3D Calc",
  "version": "6.1.0",
  "identifier": "com.tito.v3dcalc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TitoV3D Calc",
        "width": 1120,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Калькулятор себестоимости 3D-печати",
    "longDescription": "Расчёт себестоимости и цены 3D-печати: принтеры, филаменты, наценка, история заказов."
  }
}